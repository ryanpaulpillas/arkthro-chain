# Caddy gets and renews HTTPS certificates for these names automatically.
# DNS for each name must point at this server before Caddy starts.

arkthro.com, www.arkthro.com {
	encode gzip
	# The AI assistant (arkthro-assistant service); answers stream as server-sent events.
	handle /api/assistant* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}
	handle {
		root * /opt/arkthro/site
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Block explorer and JSON API, served by validator node 1.
explorer.arkthro.com, rpc.arkthro.com {
	encode gzip
	reverse_proxy 127.0.0.1:26601
}

faucet.arkthro.com {
	redir https://arkthro.com/#start
}

# The other domains we own forward to the main site, keeping the path.
arkthro.io, www.arkthro.io, arkthro.org, www.arkthro.org, arkthro.co, www.arkthro.co, arkthro.net, www.arkthro.net {
	redir https://arkthro.com{uri} permanent
}
