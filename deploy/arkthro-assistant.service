# The ARKTHRO website assistant (answers questions with Claude from the site's own pages).
[Unit]
Description=ARKTHRO website assistant
After=network-online.target arkthro-node@1.service
Wants=network-online.target

[Service]
Type=simple
User=arkthro
Group=arkthro
WorkingDirectory=/opt/arkthro/assistant
EnvironmentFile=/etc/arkthro/assistant.env
Environment=SITE_DIR=/opt/arkthro/site
Environment=NODE_URL=http://127.0.0.1:26601
Environment=ASSISTANT_HOST=127.0.0.1
Environment=ASSISTANT_PORT=8787
ExecStart=/usr/bin/node /opt/arkthro/assistant/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
